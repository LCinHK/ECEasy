# ======== ECEasy Configuration ========

# --- Knowledge Base Selection ---
# "faiss"  → FAISS ECE knowledge base  (./faiss_index_<model>/)
# "chroma" → ChromaDB network knowledge base (./arag/chromaVectorStore/)
KNOWLEDGE="faiss"

# --- UI Version ---
# "newUI" → new React/Vite chat interface (./newUI/)
# "oldUI" → original Next.js search interface (./ui/)
UI_VERSION="newUI"

# --- Server Host & Port ---
HOST="0.0.0.0"
PORT=8000

# --- Cache ---
KV_NAME="eceasy-chat-local.kv"

# --- Related Questions ---
# Set to "true" to generate related questions, "false" to disable
RELATED_QUESTIONS="true"

# --- Embedding Model (used by FAISS RAG & ingest_university.py) ---
# HuggingFace Hub model name — also determines the FAISS index folder name:
#   e.g. "all-MiniLM-L6-v2"        → ./faiss_index_all-MiniLM-L6-v2/
#   e.g. "BAAI/bge-small-en-v1.5"  → ./faiss_index_bge-small-en-v1.5/
EMBEDDING_MODEL_HUB_NAME="BAAI/bge-small-en-v1.5"

# (Optional) Path to a locally downloaded model folder for fully offline use.
# If set and the folder exists, HuggingFace Hub will NOT be contacted at all.
# Path is relative to the project root (e.g. "./models/all-MiniLM-L6-v2").
# Leave empty to always use the Hub (will download/cache on first run).
EMBEDDING_MODEL_LOCAL_PATH="./models/bge-small-en-v1.5"

# ======== Netty Chat Configuration ========
# Provider Selection: "ollama", "openai", or "deepseek"
LLM_PROVIDER="openai"

# === ChatGPT (OpenAI) ===
LLM_REMOTE_OPENAI_URL="https://api.chatanywhere.org" # "https://free.v36.cm/v1" and official ones also work
LLM_REMOTE_OPENAI_MODEL="gpt-5-mini"
LLM_REMOTE_OPENAI_API_KEY="[sk-something]"

# === DeepSeek ===
LLM_REMOTE_URL="https://api.deepseek.com"
LLM_REMOTE_MODEL="deepseek-chat"
LLM_REMOTE_API_KEY="[sk-something]"

# === Ollama (Local) ===
OLLAMA_BASE_URL="http://localhost:11434/v1"
OLLAMA_MODEL="[the one you have]"