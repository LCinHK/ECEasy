# -----------------------------------------------------------------------------
# ECEasy .gitignore (cleaned and project-focused)
# -----------------------------------------------------------------------------

# Python cache / bytecode
__pycache__/
*.py[cod]

# Virtual environments and local env config
.env
.env*.local
.venv/
venv/
env/
ENV/

# Python tooling cache
.pytest_cache/
.mypy_cache/
.nox/
.tox/
.coverage
.coverage.*
htmlcov/

# IDE / OS files
.idea/
.DS_Store

# Node / frontend deps and build cache
node_modules/
**/node_modules/
.next/
out/
build/
coverage/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# App build outputs and local db artifacts
ui/
newUI/
netty-chat.kv.*
eceasy-chat-local.kv.*

# Local vectors / model cache (large generated artifacts)
arag/chromaVectorStore/
arag/localData/
arag/modelCache/
faiss_index_*/
models/

# Local agent/prompt tooling (user requested)
/.agent/
/.claude/
/.github/

# Local ECE knowledge corpus (keep folder placeholder only)
/ECEknowledge/**
!/ECEknowledge/.gitkeep

# Nested UI workspace dependencies
/newDesign/AiChatBotInterfaceDesign/node_modules/
/newDesign/FrontPage/.github/
